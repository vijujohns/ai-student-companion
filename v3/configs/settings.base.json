  "rag": {
    "top_k": 4,
    "strict_mode": true,
    "embedding_model": "BAAI/bge-base-en-v1.5",
    "chunk_size": 1000,
    "chunk_overlap": 180,
    "summary_chunk_size": 2200,
    "summary_chunk_overlap": 250,
    "document_top_k": 8,
    "use_precomputed_summaries": true,
    "formatting": {
      "formatter_order": [
        "compare",
        "list",
        "explain",
        "definition"
      ],
      "intent_patterns": {
        "compare": [
          "\\bcompare\\b",
          "\\bdifference between\\b",
          "\\bdistinguish between\\b",
          "\\bcontrast\\b"
        ],
        "list": [
          "^(?:list|name|show)\\b",
          "^(?:what are|which are)\\b",
          "\\b(?:parts|types|kinds|examples|steps|features|uses)\\s+of\\b"
        ],
        "explain": [
          "^(?:explain|describe|summari[sz]e|tell me about)\\b",
          "^(?:how|why)\\b"
        ],
        "definition": [
          "^(?:what|who|when|where|which)\\s+(?:is|are|was|were)\\b",
          "^define\\b"
        ]
      },
      "cleanup_markers": [
        "provided context",
        "provided material",
        "document summary",
        "context start",
        "context end",
        "reference:"
      ],
      "labels": {
        "simple_meaning": "Simple meaning",
        "key_points": "Key points",
        "summary": "In short"
      },
      "max_points": 4
    }
  }
}
